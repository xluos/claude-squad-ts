{
  "name": "claude-squad-ts",
  "version": "0.2.3",
  "description": "TypeScript rewrite of claude-squad — manage multiple Claude/Aider sessions over git worktrees + tmux. Built on SolidJS + OpenTUI for native IME / CJK support.",
  "type": "module",
  "license": "MIT",
  "author": "Shuaiwu Xu <shuaiwuxu@gmail.com> (https://github.com/xluos)",
  "homepage": "https://github.com/xluos/claude-squad-ts#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xluos/claude-squad-ts.git"
  },
  "bugs": {
    "url": "https://github.com/xluos/claude-squad-ts/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "claude-squad",
    "tmux",
    "git-worktree",
    "tui",
    "terminal",
    "ai-agent",
    "codex",
    "aider",
    "gemini",
    "opentui",
    "solidjs",
    "bun"
  ],
  "bin": {
    "cs": "./dist/index.js",
    "claude-squad-ts": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "bun run src/cli/index.ts",
    "dev:tui": "bun run src/cli/index.ts",
    "build": "bun run scripts/build.ts",
    "build:link": "bun run build && bun link",
    "prepublishOnly": "rm -rf dist && bun run build",
    "start": "bun run dist/cli/index.js",
    "check": "tsc --noEmit && biome check src",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src",
    "format": "biome format --write src",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "dependencies": {
    "@lydell/node-pty": "1.2.0-beta.12",
    "@opentui/core": "0.2.14",
    "@opentui/keymap": "0.2.14",
    "@opentui/solid": "0.2.14",
    "commander": "^14.0.3",
    "simple-git": "^3.36.0",
    "solid-js": "1.9.12",
    "string-width": "^7.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@types/bun": "latest",
    "typescript": "^5.9.0"
  },
  "trustedDependencies": [
    "@lydell/node-pty",
    "@lydell/node-pty-darwin-arm64",
    "@lydell/node-pty-darwin-x64",
    "@lydell/node-pty-linux-x64",
    "@lydell/node-pty-linux-arm64",
    "@opentui/core",
    "@opentui/core-darwin-arm64",
    "@opentui/core-darwin-x64",
    "@opentui/core-linux-arm64",
    "@opentui/core-linux-x64"
  ],
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ]
}
